# Control Plane container build ignore — keep the image minimal + secret-free.
# (Used when building from the repo root with -f control-plane/deployment/Dockerfile.)

# never ship env/secrets
**/.env
**/.env.*
!control-plane/config/.env.example

# node + vcs
node_modules
.git
.gitignore

# repo areas the Control Plane must NOT contain (provider/browser/python/UI/media/tests)
ui
ui-server.mjs
site-server.mjs
scripts
tests
docs
output
*.py
lib/worker
lib/control
lib/grok-video.mjs
lib/video-*.mjs
lib/provider-accounts.mjs
lib/json-extract.mjs
generate-*.mjs
prepare-*.mjs
run-pipeline.mjs
adapt-story-to-video.mjs
presets.video.json
package-lock.json
