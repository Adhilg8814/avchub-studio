# P0 Step 5C.1 — Control Plane environment (EXAMPLE — names + safe placeholders only).
#
# Copy to a secrets-managed location; DO NOT commit real values. Secrets (peppers, DB URL,
# internal auth) are read for PRESENCE and use only — they are never printed or stored in
# /internal/config-summary. All execution/paid flags default OFF.

# ---- server ----
CONTROL_PLANE_ENV=development            # development | test | staging | production
CONTROL_PLANE_HOST=127.0.0.1             # production must set a non-loopback host explicitly
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_SHUTDOWN_TIMEOUT_MS=10000
CONTROL_PLANE_REQUEST_TIMEOUT_MS=15000
CONTROL_PLANE_MAX_REQUEST_BYTES=262144

# ---- logging ----
CONTROL_PLANE_LOG_LEVEL=info             # debug | info | warn | error | silent
CONTROL_PLANE_LOG_FORMAT=json
CONTROL_PLANE_SERVICE_NAME=control-plane

# ---- database (Step 5C.2 real PostgreSQL adapter; readiness gates on connect + schema) ----
CONTROL_PLANE_DB_ENABLED=false
# Runtime URLs (SECRET). tenant = cp_tenant_app (NOBYPASSRLS); ops = cp_ops_enumerator (BYPASSRLS).
CONTROL_PLANE_DB_URL=                     # postgres://cp_tenant_app:PASS@HOST:5432/controlplane
CONTROL_PLANE_DB_OPS_URL=                 # postgres://cp_ops_enumerator:PASS@HOST:5432/controlplane
CONTROL_PLANE_DB_OBSERVER_URL=            # optional: postgres://cp_readonly_observer:PASS@HOST/controlplane
CONTROL_PLANE_DB_APP_ROLE=cp_tenant_app
CONTROL_PLANE_DB_OPS_ROLE=cp_ops_enumerator
CONTROL_PLANE_DB_MIGRATION_ROLE=cp_migrator
CONTROL_PLANE_DB_SSL=false
CONTROL_PLANE_DB_POOL_MAX=10
CONTROL_PLANE_DB_OPS_POOL_MAX=4
CONTROL_PLANE_DB_STATEMENT_TIMEOUT_MS=10000
CONTROL_PLANE_DB_LOCK_TIMEOUT_MS=5000
CONTROL_PLANE_DB_IDLE_IN_TXN_TIMEOUT_MS=15000

# ---- migration credentials (COMMAND-ONLY — never used by the running service) ----
CONTROL_PLANE_DB_MIGRATION_URL=           # postgres://cp_migrator:PASS@HOST:5432/controlplane (SECRET; CLI only)

# ---- live test database (integration tests only; MUST be a disposable *_test DB) ----
CONTROL_PLANE_TEST_DB_URL=                # postgres://cp_tenant_app:PASS@127.0.0.1:5432/controlplane_test
CONTROL_PLANE_DB_ALLOW_DESTRUCTIVE_TESTS=false  # set true (with a *_test loopback DB) to run live tests

# ---- worker gateway (placeholder in Step 5C.1; enabling fails readiness safely) ----
CONTROL_PLANE_GATEWAY_ENABLED=false
CONTROL_PLANE_GATEWAY_PATH=/ws/worker
CONTROL_PLANE_GATEWAY_MAX_PAYLOAD_BYTES=2097152
CONTROL_PLANE_GATEWAY_HELLO_TIMEOUT_MS=10000
CONTROL_PLANE_GATEWAY_HEARTBEAT_MS=20000
CONTROL_PLANE_GATEWAY_DEGRADED_MS=45000
CONTROL_PLANE_GATEWAY_OFFLINE_MS=90000

# ---- feature flags (ALL default OFF; dependency lattice enforced at load) ----
# real_grok ⊂ worker_execution ⊂ control_plane ; scheduler ⊂ worker_execution
CONTROL_PLANE_FLAG_CONTROL_PLANE_ENABLED=false
CONTROL_PLANE_FLAG_WORKER_EXECUTION_ENABLED=false
CONTROL_PLANE_FLAG_PROJECT_WORKER_AFFINITY_ENABLED=false
CONTROL_PLANE_FLAG_SCHEDULER_ENABLED=false
CONTROL_PLANE_FLAG_REAL_GROK_WORKER_ENABLED=false
CONTROL_PLANE_FLAG_PREVIEW_SYNC_ENABLED=false

# ---- security (peppers/auth read for PRESENCE only; values never stored/printed) ----
CONTROL_PLANE_TRUST_PROXY=false
CONTROL_PLANE_ALLOWED_ORIGINS=            # comma-separated; required when enabled in production
CONTROL_PLANE_CREDENTIAL_PEPPER=          # SECRET — required in production
CONTROL_PLANE_PAIRING_PEPPER=             # SECRET — required in production
CONTROL_PLANE_INTERNAL_SERVICE_AUTH=      # SECRET — internal service auth material

# ---- deployment metadata ----
CONTROL_PLANE_INSTANCE_ID=cp-local-1
CONTROL_PLANE_VERSION=0.0.0-skeleton
CONTROL_PLANE_COMMIT_SHA=                 # required in production
CONTROL_PLANE_REGION=local

# ---- background processor (P0 Step 5C.3 — inbox/outbox engine; ALL OFF by default) ----
# The processor opens NO WebSocket (Step 5C.4). Delivery flows through an injected adapter whose
# default is UNAVAILABLE, so enabling delivery without a real gateway fails readiness safely.
CONTROL_PLANE_PROCESSOR_ENABLED=false             # requires DB enabled
CONTROL_PLANE_PROCESSOR_DELIVERY_ENABLED=false    # requires processor + DB + a real adapter (5C.4)
CONTROL_PLANE_PROCESSOR_INSTANCE_ID=              # defaults to CONTROL_PLANE_INSTANCE_ID
CONTROL_PLANE_PROCESSOR_POLL_INTERVAL_MS=1000     # 0 = no loop (runOnce driven externally)
CONTROL_PLANE_PROCESSOR_BATCH_SIZE=50
CONTROL_PLANE_PROCESSOR_CLAIM_LEASE_MS=30000
CONTROL_PLANE_PROCESSOR_DELIVERY_TIMEOUT_MS=10000
CONTROL_PLANE_PROCESSOR_SETTLEMENT_TIMEOUT_MS=30000
CONTROL_PLANE_PROCESSOR_RECONCILE_TIMEOUT_MS=60000
CONTROL_PLANE_PROCESSOR_MAX_ATTEMPTS=5
CONTROL_PLANE_PROCESSOR_INITIAL_BACKOFF_MS=1000
CONTROL_PLANE_PROCESSOR_MAX_BACKOFF_MS=60000      # must be >= INITIAL_BACKOFF_MS
CONTROL_PLANE_PROCESSOR_SKEW_MS=120000
CONTROL_PLANE_PROCESSOR_OFFER_EXPIRY_SWEEP_ENABLED=false      # requires processor
CONTROL_PLANE_PROCESSOR_RECONCILIATION_SWEEP_ENABLED=false   # requires processor
CONTROL_PLANE_PROCESSOR_RETENTION_SWEEP_ENABLED=false        # requires processor
CONTROL_PLANE_PROCESSOR_RETENTION_BATCH_SIZE=50
CONTROL_PLANE_PROCESSOR_RETENTION_MS=604800000              # 7 days
CONTROL_PLANE_PROCESSOR_DEAD_LETTER_RETENTION_MS=2592000000 # 30 days

# ---- worker WebSocket gateway (P0 Step 5C.4 — OFF by default) ----
# Opens a real WS endpoint on the standalone Control Plane HTTP server. Enabling requires DB +
# processor + a credential pepper. It executes NO providers. Authorization-header-only auth.
CONTROL_PLANE_GATEWAY_ENABLED=false                  # requires DB + processor + credential pepper
CONTROL_PLANE_GATEWAY_PATH=/ws/worker
CONTROL_PLANE_GATEWAY_INSTANCE_ID=                   # defaults to CONTROL_PLANE_INSTANCE_ID
CONTROL_PLANE_GATEWAY_HELLO_TIMEOUT_MS=10000
CONTROL_PLANE_GATEWAY_MAX_FRAME_BYTES=1048576
CONTROL_PLANE_GATEWAY_MAX_JSON_DEPTH=24
CONTROL_PLANE_GATEWAY_MAX_ARRAY_ITEMS=4096
CONTROL_PLANE_GATEWAY_MAX_OBJECT_KEYS=256
CONTROL_PLANE_GATEWAY_MAX_MESSAGES_PER_WINDOW=240
CONTROL_PLANE_GATEWAY_RATE_LIMIT_WINDOW_MS=10000
CONTROL_PLANE_GATEWAY_MAX_PREAUTH_PER_WINDOW=30
CONTROL_PLANE_GATEWAY_MAX_PENDING_INBOUND=64
CONTROL_PLANE_GATEWAY_MAX_CONCURRENT_INBOUND=1       # serial per connection (preserves ordering)
CONTROL_PLANE_GATEWAY_MAX_BUFFERED_BYTES=4194304
CONTROL_PLANE_GATEWAY_DELIVERY_WRITE_TIMEOUT_MS=10000
CONTROL_PLANE_GATEWAY_HEARTBEAT_MS=20000
CONTROL_PLANE_GATEWAY_DEGRADED_MS=45000
CONTROL_PLANE_GATEWAY_OFFLINE_MS=90000               # must exceed DEGRADED_MS
CONTROL_PLANE_GATEWAY_SESSION_LEASE_MS=120000
CONTROL_PLANE_GATEWAY_RESUME_TOKEN_TTL_MS=120000
CONTROL_PLANE_GATEWAY_ALLOWED_PROTOCOL_VERSIONS=1
# Production: set CONTROL_PLANE_ALLOWED_ORIGINS (no wildcard) and CONTROL_PLANE_TRUST_PROXY=true
# behind a TLS-terminating reverse proxy; loopback bind is dev/test only.

# ---- worker pairing + credential lifecycle (P0 Step 5C.5 — OFF by default) ----
# One-time pairing codes + Worker credential issuance/rotation/revocation/disable. Enabling requires
# DB + BOTH peppers (CONTROL_PLANE_PAIRING_PEPPER + CONTROL_PLANE_CREDENTIAL_PEPPER above). Executes
# NO providers. The operator API + staging service token are a SEPARATE gate and the staging token
# is FORBIDDEN in production. Peppers/token VALUES never appear in the config summary or logs.
CONTROL_PLANE_PAIRING_ENABLED=false                    # requires DB + pairing pepper + credential pepper
CONTROL_PLANE_PAIRING_CLAIM_PATH=/worker/pair
CONTROL_PLANE_PAIRING_CODE_TTL_MS=900000               # 15 min default code lifetime
CONTROL_PLANE_PAIRING_MAX_CODE_TTL_MS=86400000         # 24 h ceiling
CONTROL_PLANE_PAIRING_MAX_ACTIVE_CODES=50              # per workspace
CONTROL_PLANE_PAIRING_MAX_FAILED_ATTEMPTS=5            # per code → LOCKED
CONTROL_PLANE_PAIRING_RATE_LIMIT_WINDOW_MS=60000
CONTROL_PLANE_PAIRING_MAX_ISSUE_PER_WINDOW=30          # durable per-workspace issuance limit
CONTROL_PLANE_PAIRING_MAX_CLAIMS_PER_WINDOW=20         # per-remote in-memory claim limit
CONTROL_PLANE_PAIRING_CREDENTIAL_TTL_MS=2592000000     # 30 days
# Operator API (staging only) — a separate gate from the claim surface.
CONTROL_PLANE_PAIRING_OPERATOR_API_ENABLED=false
CONTROL_PLANE_PAIRING_STAGING_OPERATOR_AUTH_ENABLED=false   # FORBIDDEN in production
CONTROL_PLANE_PAIRING_OPERATOR_ACTOR_ID=operator:staging
CONTROL_PLANE_PAIRING_OPERATOR_TOKEN=                       # SECRET — staging break-glass token (>=16 chars)

# ---- staging Project/Generation/Job/Result API (P0 Step 5C.6 — OFF by default) ----
# The minimal staging API the future Studio UI will use to create projects, assign a paired Worker,
# submit a fake video generation, dispatch, observe/cancel/retry jobs, and read result metadata.
# Reuses the pairing staging operator token for auth; the workspace is resolved from config (never a
# request body). Enabling it does NOT enable Gateway/Processor/Pairing/paid execution. FAKE jobs
# only in 5C.6; FORBIDDEN in production. Requires DB + a valid workspace id + staging operator auth.
CONTROL_PLANE_STAGING_API_ENABLED=false                 # requires DB + workspace id + staging operator auth
CONTROL_PLANE_STAGING_API_WORKSPACE_ID=                 # ws_<ULID> the staging operator acts within
CONTROL_PLANE_STAGING_API_MAX_BODY_BYTES=65536
CONTROL_PLANE_STAGING_API_DEFAULT_PAGE_SIZE=25
CONTROL_PLANE_STAGING_API_MAX_PAGE_SIZE=100
CONTROL_PLANE_STAGING_API_MAX_PROMPT_LENGTH=2000
CONTROL_PLANE_STAGING_API_ALLOWED_DURATIONS=5,10,15
CONTROL_PLANE_STAGING_API_ALLOWED_ASPECT_RATIOS=16:9,9:16,1:1
CONTROL_PLANE_STAGING_API_ALLOWED_OUTPUT_FORMATS=mp4
CONTROL_PLANE_STAGING_API_MAX_OUTPUT_COUNT=1
CONTROL_PLANE_STAGING_API_DISPATCH_ON_CREATE=false      # explicit POST /jobs/:id/dispatch by default
CONTROL_PLANE_STAGING_API_ALLOW_FAKE_JOBS_ONLY=true     # MUST be true in Step 5C.6

# ---- creator-focused staging Studio UI (P0 Step 5C.7 â€” OFF by default) ----
# Temporary, process-local browser sessions over the 5C.6 staging API. Forbidden in production.
# Pairing is an independent capability: the UI remains available when pairing-code APIs are off.
CONTROL_PLANE_STAGING_UI_ENABLED=false                  # requires staging API + valid workspace
CONTROL_PLANE_STAGING_UI_SESSION_TTL_MS=1800000         # 30 minutes; restart invalidates sessions
CONTROL_PLANE_STAGING_UI_MAX_SESSIONS=64
CONTROL_PLANE_STAGING_UI_MAX_BODY_BYTES=65536
