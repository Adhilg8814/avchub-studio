# AVC Studio — copy to .env and fill in. NEVER commit .env.
# `npm run control-plane:check-config` prints a sanitized summary and names anything still missing.

# ---------------------------------------------------------------- required
# PostgreSQL for the application role. The database must already exist; run
# `npm run control-plane:db:migrate` to create the schema.
# scan-secrets:allow connection-string template, CHANGE_ME is not a password
CONTROL_PLANE_DB_URL=postgres://cp_tenant_app:CHANGE_ME@127.0.0.1:5432/avc_studio

# Server-side peppers. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing either one invalidates every existing worker credential / pairing code.
CONTROL_PLANE_CREDENTIAL_PEPPER=
CONTROL_PLANE_PAIRING_PEPPER=

# ---------------------------------------------------------------- server
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8787
CONTROL_PLANE_ENV=development
CONTROL_PLANE_LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API. Required outside development.
CONTROL_PLANE_ALLOWED_ORIGINS=http://127.0.0.1:8787

# ---------------------------------------------------------------- data and tools
# Writable directory for media, caches and credentials. Keep it OUTSIDE the repository.
# Default: a sibling directory named <repo>-data.
AVC_STUDIO_HOME=

# Only needed when ffmpeg/ffprobe are not on PATH. FFmpeg is GPL and is not bundled.
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------------------------------------------------------- providers
# Semicolon- or comma-separated module paths, each default-exporting a plugin that satisfies
# lib/providers/provider-plugin.mjs. Empty means the mock provider only — which is enough to run
# the whole pipeline end to end. No provider ships with this repository.
AVC_STUDIO_PROVIDER_PLUGINS=

# Optional: some Anthropic-compatible proxies truncate output below the API's own limit. Declare it
# here; it applies only to a non-default base URL.
LLM_MAX_OUTPUT_TOKENS=

# ---------------------------------------------------------------- optional: native auth
CONTROL_PLANE_NATIVE_AUTH_UI_ENABLED=false
CONTROL_PLANE_NATIVE_AUTH_ROUTES_ENABLED=false
CONTROL_PLANE_NATIVE_AUTH_ENFORCEMENT_ENABLED=false
# 32 random bytes, base64. Seals TOTP secrets at rest; losing it makes enrolled MFA unreadable.
CONTROL_PLANE_AUTH_SECRETBOX_KEY=

# ---------------------------------------------------------------- optional: tests
# Point at a local PostgreSQL bin directory to run the database-backed suites. Without it they SKIP.
PGBIN=
# Must contain "_test" — the safety check refuses to run destructive tests against anything else.
CONTROL_PLANE_TEST_DB_URL=
CONTROL_PLANE_DB_ALLOW_DESTRUCTIVE_TESTS=false
